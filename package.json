{
  "name": "qawwam-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev dist --port 8788 --binding API_BASE=http://localhost:8787",
    "build": "tsc -b && npm run typecheck:functions && vite build",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "lint": "oxlint",
    "disclosures:sync": "node scripts/fetch-disclosures.mjs",
    "disclosures:check": "node scripts/fetch-disclosures.mjs --check",
    "preview": "vite preview",
    "deploy:dev": "npm run build && wrangler pages deploy dist --project-name=qawwam-landing --branch=dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=qawwam-landing"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-mockframe": "^1.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  }
}

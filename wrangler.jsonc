{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qawwam-landing",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-15",
  "vars": {
    // Invite tokens are minted by the store app against the PROD api, so the
    // Pages Functions must look them up there too. This is the only place the
    // API origin is configured: the browser reads the invite same-origin
    // through `/api/khatam-invite/*`.
    "API_BASE": "https://qawwam-api-prod.hadiayo39.workers.dev"
  },
  // The prayer proxy protects itself with PRAYER_RATE_LIMITER when that binding
  // exists. It cannot be declared here: Pages configuration does not support
  // `ratelimits`, and wrangler refuses to deploy with it. Throttle
  // /api/prayer/* with a Cloudflare WAF rate-limiting rule instead.
  "env": {
    "preview": {
      "vars": {
        "API_BASE": "https://qawwam-api.hadiayo39.workers.dev"
      }
    }
  }
}

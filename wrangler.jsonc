{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qawwam-landing",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-15",
  "vars": {
    // Invite tokens are minted by the store app against the PROD api, so the
    // Pages Functions must look them up there too. Keep this in step with
    // VITE_API_BASE in `.env.production`: this one feeds the Functions, that
    // one feeds the browser bundle.
    "API_BASE": "https://qawwam-api-prod.hadiayo39.workers.dev"
  },
  // Protect the public prayer proxy from being used to exhaust the upstream
  // API bearer token. Limits are approximate per Cloudflare location.
  "ratelimits": [
    {
      "name": "PRAYER_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "API_BASE": "https://qawwam-api.hadiayo39.workers.dev"
      }
    }
  }
}
